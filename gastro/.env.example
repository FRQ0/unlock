# Banco PostgreSQL (Neon, Supabase, Railway ou próprio)
DATABASE_URL="postgresql://gastro:gastro@localhost:5432/gastro"
# Conexão direta, sem pool (na Neon, a integração da Vercel cria sozinha)
DATABASE_URL_UNPOOLED="postgresql://gastro:gastro@localhost:5432/gastro"

# Segredo da sessão: gere com `openssl rand -base64 48`
AUTH_SECRET=""

# Endereço público da plataforma (usado no QR Code e na plaquinha NFC)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Armazenamento de fotos e vídeos
#   local       -> grava em public/uploads (só para desenvolvimento)
#   vercel-blob -> Vercel Blob (produção na Vercel; exige BLOB_READ_WRITE_TOKEN)
STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""

# Gateway de pagamento recorrente: "none" enquanto não houver integração
PAYMENT_PROVIDER="none"

# Primeiro usuário Master da Unlock (criado pelo seed)
MASTER_EMAIL=""
MASTER_PASSWORD=""
